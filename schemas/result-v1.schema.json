{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nicechunk:pouw:schema:result-v1",
  "title": "NiceChunk PoUW ResultV1 debug representation",
  "description": "A non-consensus JSON/Base64 view of the canonical NCPR binary result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "taskId",
    "candidateEncoding",
    "encodingHash",
    "minerProof",
    "nonConsensusSearchMetadata"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "taskId": { "$ref": "#/$defs/hash32" },
    "candidateEncoding": { "$ref": "#/$defs/base64" },
    "encodingHash": { "$ref": "#/$defs/hash32" },
    "minerProof": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "signature"],
          "properties": {
            "identity": { "$ref": "#/$defs/base64" },
            "signature": { "$ref": "#/$defs/base64" }
          }
        }
      ]
    },
    "nonConsensusSearchMetadata": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "attempts", "elapsedMs", "seed", "threads"],
          "properties": {
            "algorithm": { "type": "string", "minLength": 1, "maxLength": 128 },
            "attempts": { "$ref": "#/$defs/u64" },
            "elapsedMs": { "$ref": "#/$defs/u64" },
            "seed": { "$ref": "#/$defs/u64" },
            "threads": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      ]
    }
  },
  "$defs": {
    "hash32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base64": {
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "u64": {
      "type": "integer",
      "minimum": 0
    }
  }
}
