{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nicechunk:pouw:schema:task-v1",
  "title": "NiceChunk PoUW TaskV1 debug representation",
  "description": "A non-consensus JSON/Base64 view of the canonical NCPT binary task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "vmVersion",
    "costModelVersion",
    "profile",
    "assetId",
    "semanticRoot",
    "incumbentFormat",
    "incumbentEncoding",
    "incumbentEncodingHash",
    "limits",
    "networkReference"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "vmVersion": { "const": 1 },
    "costModelVersion": { "const": 1 },
    "profile": {
      "enum": ["terrain_delta", "building", "forged_item"]
    },
    "assetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "semanticRoot": { "$ref": "#/$defs/hash32" },
    "incumbentFormat": {
      "enum": ["chunkbroken-v1", "ncm3-v1", "ncf1-v15", "pouw-vm-v1"]
    },
    "incumbentEncoding": { "$ref": "#/$defs/base64" },
    "incumbentEncodingHash": { "$ref": "#/$defs/hash32" },
    "limits": { "$ref": "#/$defs/limits" },
    "networkReference": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["network", "slot", "expiresAtSlot"],
          "properties": {
            "network": { "type": "string", "minLength": 1, "maxLength": 64 },
            "slot": { "$ref": "#/$defs/u64" },
            "expiresAtSlot": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/u64" }
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "hash32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base64": {
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "u64": {
      "type": "integer",
      "minimum": 0
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxInputBytes",
        "maxCommands",
        "maxMaterials",
        "maxPatches",
        "maxVoxels",
        "maxWrites",
        "maxDecodeUnits",
        "maxMemoryBytes",
        "maxExpandedPerOp"
      ],
      "properties": {
        "maxInputBytes": { "$ref": "#/$defs/u32" },
        "maxCommands": { "$ref": "#/$defs/u32" },
        "maxMaterials": { "$ref": "#/$defs/u32" },
        "maxPatches": { "$ref": "#/$defs/u32" },
        "maxVoxels": { "$ref": "#/$defs/u32" },
        "maxWrites": { "$ref": "#/$defs/u32" },
        "maxDecodeUnits": { "$ref": "#/$defs/u64" },
        "maxMemoryBytes": { "$ref": "#/$defs/u64" },
        "maxExpandedPerOp": { "$ref": "#/$defs/u32" }
      }
    }
  }
}
